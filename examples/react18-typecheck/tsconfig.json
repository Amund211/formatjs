{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2020", "ES2020.Intl", "ES2021.Intl", "ES2022.Intl"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@formatjs/icu-messageformat-parser": [
        "../../bazel-bin/packages/icu-messageformat-parser/pkg/index.d.ts"
      ],
      "@formatjs/intl": ["../../bazel-bin/packages/intl/pkg/index.d.ts"],
      "intl-messageformat": [
        "../../bazel-bin/packages/intl-messageformat/pkg/index.d.ts"
      ],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react-dom/client": ["./node_modules/@types/react-dom/client.d.ts"],
      "react-intl": ["../../bazel-bin/packages/react-intl/pkg/index.d.ts"],
      "react-intl/server": [
        "../../bazel-bin/packages/react-intl/pkg/server.d.ts"
      ],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "types": ["react", "react-dom"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src"]
}
